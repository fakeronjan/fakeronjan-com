<style>
/* Card art: drawn inline so it follows the theme. Birthday Stats: its calendar page and halfway-back timeline. Sun Stats: a crop of its sky picture.
   Flight Stats: a route arc between two airports over the page's on-time split */
.other-art { display: block; width: 100%; height: auto; border-radius: 6px; margin-bottom: 0.3rem;
  --art-night: #e3e8ec; --art-twi: #f7dc96; --art-day: #f9d77a; --art-edge: #b9820f; --art-sun: #f2b632; --art-line: var(--fg); }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .other-art { --art-night: #24272f; --art-twi: #5e4c1f; --art-day: #8a6a1c; --art-edge: #f2c45a; --art-sun: #d9a21f; }
}
:root[data-theme="dark"] .other-art { --art-night: #24272f; --art-twi: #5e4c1f; --art-day: #8a6a1c; --art-edge: #f2c45a; --art-sun: #d9a21f; }
.fl-art { --art-sky: #e6f0f5; --art-ok: #15803d; --art-late: #d97706; --art-cancel: #b91c1c; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .fl-art { --art-sky: #1e2830; --art-ok: #34d399; --art-late: #fbbf24; --art-cancel: #f87171; }
}
:root[data-theme="dark"] .fl-art { --art-sky: #1e2830; --art-ok: #34d399; --art-late: #fbbf24; --art-cancel: #f87171; }
.bd-art { --art-bg: #f6eef2; --art-edge2: #e2c6d2; --art-zone: color-mix(in srgb, var(--accent) 18%, transparent); --art-label: color-mix(in srgb, var(--fg) 45%, transparent); }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .bd-art { --art-bg: #2a2128; --art-edge2: #4a3742; }
}
:root[data-theme="dark"] .bd-art { --art-bg: #2a2128; --art-edge2: #4a3742; }
.site-map-desc { text-wrap: balance; text-align: center; }   /* no lone last word; centered (Ronjan 11/24) */
/* Cards a third of the row (Ronjan 11/24): bigger than the homepage's quarters, and room for a third card */
.site-map > a { grid-column: span 4; }
@media (max-width: 879px) { .site-map > a { grid-column: span 6; } }
@media (max-width: 639px) { .site-map > a { grid-column: auto; } }
</style>


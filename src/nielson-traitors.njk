  .pm-now { color: var(--pm-accent); font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; }

  /* Rule Set 4.0: the four big changes (the infographic as cards, Ronjan 11/25). One row of four on
     desktop (wider than the text column), 2x2 on tablets, one column on phones. Subgrid lines up each
     card's parts across a row, so the example boxes sit level. Bullets never wrap: card text scales
     with the card's width (--cw, from the wrapper's cqi; a container on the card itself would switch off subgrid). Each pundit speaks in their own face, as in the image version. */
  .pm-r4-wrap { margin-inline: calc((100% - min(1432px, 100vw)) / 2);   /* centered breakout past the 980px column, up to 1400px of cards */
                 padding: 0 16px; box-sizing: border-box; display: grid; justify-items: center; container-type: inline-size;
                overflow-x: clip; }   /* the tab's fonts load on first show; fallback text is wider for a moment */
  .pm-r4 { width: 100%; max-width: 1400px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px;
            --cw: calc((min(100cqi, 1400px) - 36px) / 4 - 32px); }   /* a card's text width (card padding + border = 32px) */
  @media (max-width: 1279px) { .pm-r4 { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 980px; --cw: calc((min(100cqi, 980px) - 12px) / 2 - 32px); } }
  @media (max-width: 760px) { .pm-r4 { grid-template-columns: minmax(0, 1fr); --cw: calc(100cqi - 32px); } }
  .pm-r4-card { --hue: #2f8f5c; display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 12px;
                padding: 14px; border: 2px solid var(--hue); border-radius: 12px; background: var(--pm-panel); }
  .pm-r4-card[data-p="s"] { --hue: #2f6fae; } .pm-r4-card[data-p="d"] { --hue: #23824e; } .pm-r4-card[data-p="t"] { --hue: #b85a14; } .pm-r4-card[data-p="p"] { --hue: #b03a5e; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .pm-r4-card[data-p="s"] { --hue: #609cdc; } :root:not([data-theme="light"]) .pm-r4-card[data-p="d"] { --hue: #34a868; }
    :root:not([data-theme="light"]) .pm-r4-card[data-p="t"] { --hue: #ec8030; } :root:not([data-theme="light"]) .pm-r4-card[data-p="p"] { --hue: #ce4868; }
  }
  :root[data-theme="dark"] .pm-r4-card[data-p="s"] { --hue: #609cdc; } :root[data-theme="dark"] .pm-r4-card[data-p="d"] { --hue: #34a868; }
  :root[data-theme="dark"] .pm-r4-card[data-p="t"] { --hue: #ec8030; } :root[data-theme="dark"] .pm-r4-card[data-p="p"] { --hue: #ce4868; }
  .pm-r4-card > * { min-width: 0; font-size: min(17px, calc(var(--cw) / 17.8)); }
  .pm-r4-card > .pm-r4-list { font-size: min(17px, calc(var(--cw) / 21.8)); }   /* the longest bullet is ~21.4em with its row padding: it fits the card width on one line */
  .pm-r4-head { display: flex; align-items: center; gap: 0.5em; }
  .pm-r4-n { flex: none; width: 1.7em; height: 1.7em; border-radius: 7px; background: #a01c28; color: #f0e6d6; display: grid; place-items: center;
             font-family: "Barlow Condensed", sans-serif; font-weight: 700; font-size: 1.15em; }
  .pm-r4-head h2 { margin: 0; font-family: "Grenze Gotisch", Georgia, serif; font-weight: 800; font-size: 1.55em; line-height: 1.1; color: var(--pm-ink); white-space: nowrap; }
  .pm-r4-who { display: grid; grid-template-columns: 4.2em minmax(0, 1fr); gap: 0.4em 0.7em; align-items: center; align-content: start; }
  .pm-r4-who img { width: 4.2em; height: 4.2em; border-radius: 50%; border: 3px solid var(--hue); box-sizing: border-box; }
  .pm-r4-name { font-family: "Barlow Condensed", sans-serif; font-weight: 700; font-size: 0.95em; line-height: 1.15; color: var(--hue); text-wrap: balance; }
  .pm-r4-says { grid-column: 1 / -1; margin: 0; color: var(--pm-ink); line-height: 1.3; text-wrap: pretty; }
  .pm-r4-card[data-p="s"] .pm-r4-says { font-family: "Saira Condensed", sans-serif; font-weight: 600; font-size: 1.08em; }
  .pm-r4-card[data-p="d"] .pm-r4-says { font-family: "Playfair Display", Georgia, serif; font-weight: 500; font-size: 1em; }
  .pm-r4-card[data-p="t"] .pm-r4-says { font-family: "Special Elite", "Courier New", monospace; font-size: 0.95em; }
  .pm-r4-card[data-p="p"] .pm-r4-says { font-family: "Grenze Gotisch", Georgia, serif; font-weight: 500; font-size: 1.12em; }
  .pm-r4-list, .pm-r4-table { font-family: "Barlow Condensed", sans-serif; font-weight: 600; color: var(--pm-ink); }
  .pm-r4-list { list-style: none; counter-reset: r4; margin: 0; padding: 0; display: grid; grid-auto-rows: 1fr; align-content: stretch; }   /* striped rows like card 1's table, stretched to fill the row it sets */
  .pm-r4-list li { margin: 0; counter-increment: r4; display: flex; align-items: center; gap: 0.5em; white-space: nowrap; padding: 0.35em 0.5em; }
  .pm-r4-list li:nth-child(odd) { background: color-mix(in srgb, var(--pm-ink) 6%, transparent); }
  .pm-r4-list li::before { content: counter(r4); flex: none; width: 1.35em; height: 1.35em; border-radius: 50%; background: var(--hue); color: #fff;
                           display: grid; place-items: center; font-weight: 700; font-size: 0.85em; }
  .pm-r4-table { border-collapse: collapse; width: 100%; align-self: start; }
  .pm-r4-table td { padding: 0.18em 0.5em; white-space: nowrap; }
  .pm-r4-table tr:nth-child(odd) td { background: color-mix(in srgb, var(--pm-ink) 6%, transparent); }
  .pm-r4-table td:first-child { color: var(--pm-gold); font-weight: 700; }
  .pm-r4-ex { border: 2px solid color-mix(in srgb, var(--pm-gold) 70%, transparent); border-radius: 10px; padding: 0.6em 0.8em;
              background: color-mix(in srgb, var(--pm-ink) 4%, transparent); font-family: "Barlow Condensed", sans-serif; font-weight: 600; color: var(--pm-ink); line-height: 1.3; }
  .pm-r4-ex b { display: block; color: var(--pm-gold); font-weight: 700; font-size: 0.85em; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 0.2em; }
  .pm-r4-ex p { margin: 0; text-wrap: pretty; }
</style>


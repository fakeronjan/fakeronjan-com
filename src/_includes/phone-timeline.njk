{% raw %}
<div class="pt">
<style>
.pt { --bg: #f3f4f6; --panel: #ffffff; --ink: var(--fg); --ink-2: #4a4a4a; --ink-3: #6b6b6b; --rule: #e4e4e4; --grid: #efefef; --lane-ink: #2a2f38; --photo: #ffffff; --focus: #2a78d6; --apple: #4260c4; --samsung: #10703a; --google: #8dbd42; --motorola: #008674; --microsoft: #4dbc92; --htc: #85861f; --f-display: "Space Grotesk", system-ui, sans-serif; --f-body: "Manrope", system-ui, sans-serif; --f-data: "Manrope", system-ui, sans-serif; font-size: 15px; line-height: 1.5; color: var(--ink); margin-top: 2.5rem; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .pt { --bg: #2a2a31; --panel: #1e1e24; --ink: var(--fg); --ink-2: #c4c4c8; --ink-3: #9a9aa0; --rule: #2e2e36; --grid: #26262d; --lane-ink: #e2e2e6; --photo: #f4f5f3; --focus: #6da7ec; --apple: #5f80e0; --samsung: #1a763f; --google: #75a322; --motorola: #107c5a; --microsoft: #52ab69; --htc: #887000; } }
:root[data-theme="dark"] .pt { --bg: #2a2a31; --panel: #1e1e24; --ink: var(--fg); --ink-2: #c4c4c8; --ink-3: #9a9aa0; --rule: #2e2e36; --grid: #26262d; --lane-ink: #e2e2e6; --photo: #f4f5f3; --focus: #6da7ec; --apple: #5f80e0; --samsung: #1a763f; --google: #75a322; --motorola: #107c5a; --microsoft: #52ab69; --htc: #887000; }
.pt * { box-sizing: border-box; }
.pt h2, .pt h3 {font-family: var(--f-display); text-wrap: balance; margin: 0;}
.pt h2 {font-size: 24px; font-weight: 700; letter-spacing: -0.01em;}
.pt h3 {font-size: 15px; font-weight: 700; font-family: var(--f-body);}
.pt p {margin: 0;}
.pt li {margin: 0;}
.pt .num {font-family: var(--f-data); font-variant-numeric: tabular-nums;}
.pt nav.toc {display: flex; flex-wrap: nowrap; gap: 6px; overflow-x: auto; scrollbar-width: none; position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--bg); padding-block: 10px; margin-inline: -4px; padding-inline: 4px; border-bottom: 1px solid var(--rule);}
.pt nav.toc::-webkit-scrollbar {display: none;}
.pt nav.toc a {flex: 0 0 auto; white-space: nowrap; color: var(--ink-2); text-decoration: none; font-size: 13px; font-weight: 500; padding: 5px 10px; border-radius: 999px; border: 1px solid var(--rule); background: var(--panel);}
.pt nav.toc a:hover {color: var(--ink); border-color: var(--ink-3);}
.pt section {display: grid; gap: 14px; padding-block: 44px 8px; scroll-margin-top: 56px;}
.pt .panel {background: var(--panel); border: 1px solid var(--rule); border-radius: 10px; padding: 18px; min-width: 0;}
.pt .panel > * + * {margin-top: 12px;}
.pt .note {font-size: 13px; color: var(--ink-3);}
.pt .scroll-x {overflow-x: auto;}
.pt .scroll-x > svg {min-width: 760px;}
.pt svg {display: block; width: 100%; height: auto; overflow: visible;}
.pt svg text {fill: var(--ink-3); font-family: var(--f-data); font-size: 11px;}
.pt svg .lbl {fill: var(--ink); font-weight: 600;}
.pt svg .lane {fill: var(--lane-ink); font-family: var(--f-body); font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;}
.pt svg .axis {fill: var(--ink-3);}
.pt svg .gridline {stroke: var(--grid); stroke-width: 1;}
.pt svg .now {stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 2 3;}
.pt .mark {cursor: pointer; outline: none;}
.pt .mark:hover rect, .pt .mark:hover path {filter: brightness(1.12);}
.pt .mark:focus-visible rect:first-of-type {stroke: var(--focus); stroke-width: 2;}
.pt .legend {display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--ink-2);}
.pt .legend i {display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px;}
.pt .legend i.pin {width: 8px; height: 8px; border-radius: 1px; transform: rotate(45deg); background: var(--ink-3); margin-right: 8px;}
.pt .legend i.dash {background: transparent; border: 1.5px dashed var(--apple);}
.pt .legend i.paid {background: repeating-linear-gradient(45deg, var(--ink-3) 0 3px, color-mix(in srgb, var(--ink-3) 45%, var(--panel)) 3px 5px);}
.pt svg .emp {fill: var(--ink-2); font-weight: 700;}
.pt .ph {background: var(--photo); border-radius: 5px; display: flex; align-items: center; justify-content: center; padding: 2px;}
.pt .ph img {max-width: 100%; max-height: 100%; object-fit: contain; display: block;}
.pt .rank {display: grid; gap: 4px;}
.pt .rrow {display: grid; grid-template-columns: 1.8em 30px minmax(0, 16.5em) minmax(0, 1fr) 6.5em; gap: 10px; align-items: center; font-size: 13.5px; cursor: pointer; outline: none; border-radius: 6px;}
.pt .rrow:focus-visible {outline: 2px solid var(--focus); outline-offset: 2px;}
.pt .rrow .r {color: var(--ink-3); font-family: var(--f-data); text-align: right; font-size: 12px;}
.pt .rrow .ph {width: 30px; height: 34px;}
.pt .rrow .n {white-space: nowrap; overflow: hidden; text-overflow: ellipsis;}
.pt .rrow .b {height: 10px; border-radius: 0 3px 3px 0;}
.pt .rrow .d {font-family: var(--f-data); font-variant-numeric: tabular-nums; color: var(--ink-3); font-size: 12px;}
.pt .rank + h3 {padding-top: 14px; border-top: 1px solid var(--rule);}
.pt .ends {display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 28px;}
.pt .end .h {display: flex; justify-content: space-between; gap: 8px; font-size: 13.5px; border-bottom: 1px solid var(--grid); padding-bottom: 4px; margin-bottom: 8px;}
.pt .end .h b {font-weight: 700;}
.pt .end .h span {font-family: var(--f-data); color: var(--ink-3);}
.pt .end .phs {display: flex; flex-wrap: wrap; gap: 5px;}
.pt .end .ph {width: 36px; height: 42px; cursor: pointer; outline: none;}
.pt .end .ph:focus-visible {outline: 2px solid var(--focus); outline-offset: 2px;}
.pt .method-notes {margin-top: 56px; padding-top: 22px; border-top: 1px solid var(--rule); display: grid; gap: 10px; font-size: 13px; color: var(--ink-2);}
.pt .method-notes ul {margin: 0; padding-left: 18px; display: grid; gap: 4px;}
.pt #pt-tip {position: fixed; pointer-events: none; z-index: 20; background: var(--ink); color: var(--panel); font-size: 12.5px; line-height: 1.45; padding: 9px; border-radius: 8px; width: 290px; max-width: calc(100vw - 16px); display: none; grid-template-columns: 76px minmax(0, 1fr); gap: 10px;}
.pt #pt-tip.on {display: grid;}
.pt #pt-tip .ph {height: 92px; background: #fff;}
.pt #pt-tip b {font-weight: 700; display: block; line-height: 1.3;}
.pt #pt-tip .m {opacity: .75;}
.pt #pt-tip .d {font-family: var(--f-data); font-variant-numeric: tabular-nums; font-size: 12px; opacity: .85;}
.pt #pt-tip .body {display: grid; gap: 2px; align-content: start; min-width: 0;}
.pt .favs {display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px;}
.pt .fav {display: grid; gap: 6px; align-content: start; cursor: pointer; outline: none; border-radius: 8px;}
.pt .fav:focus-visible {outline: 2px solid var(--focus); outline-offset: 3px;}
.pt .fav .ph {height: 170px; padding: 10px; border: 1px solid var(--rule);}
.pt .fav b {font-weight: 700; font-size: 14.5px; line-height: 1.3;}
.pt .fav .d {font-family: var(--f-data); font-variant-numeric: tabular-nums; font-size: 12.5px; color: var(--ink-3);}
.pt .fav .q {font-size: 13px; color: var(--ink-2);}
.pt .pref {display: grid; gap: 10px; padding-block: 16px; border-top: 1px solid var(--rule);}
.pt .pref:first-of-type {border-top: 0; padding-top: 4px;}
.pt .pref svg {min-width: 0;}
.pt .pref .strip {overflow-x: auto;}
.pt .pref .strip svg {min-width: 760px;}
.pt .cats {display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 28px;}
.pt .cat {display: grid; grid-template-columns: 12px minmax(0, 1fr) 4.6em 4.6em 4em 4em; gap: 8px; align-items: center; font-size: 13.5px;}
.pt .cat .sw {width: 12px; height: 12px; border-radius: 3px; box-shadow: inset 0 0 0 1px rgb(0 0 0 / .12);}
.pt .cat .nm {white-space: nowrap; overflow: hidden; text-overflow: ellipsis;}
.pt .cat .bar {height: 8px; border-radius: 0 3px 3px 0; background: var(--ink-3); opacity: .55;}
.pt .cat .v {font-family: var(--f-data); font-variant-numeric: tabular-nums; text-align: right; color: var(--ink-2); font-size: 12.5px;}
.pt .cat .v.dim {color: var(--ink-3);}
.pt .cathead {display: grid; grid-template-columns: 12px minmax(0, 1fr) 4.6em 4.6em 4em 4em; gap: 8px; font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em;}
.pt .cathead span:nth-child(n+3) {text-align: right;}
@media (max-width: 760px) { .pt .cats {grid-template-columns: minmax(0, 1fr);} .pt .cats > div + div .cathead {display: none;} .pt .pref .strip svg {min-width: 0;} }
@media (max-width: 520px) { .pt .cat, .pt .cathead {grid-template-columns: 12px minmax(0, 1fr) 4.2em 3.6em 3.4em 3.4em; gap: 6px;} }
@media (max-width: 640px) {
  .pt .ends {grid-template-columns: minmax(0, 1fr);}
  .pt .rrow {grid-template-columns: 1.6em 30px minmax(0, 1fr) 5.5em; row-gap: 3px;}
  .pt .rrow .r, .pt .rrow .ph {grid-row: span 2;}
  .pt .rrow .n {grid-column: 3 / span 2;}
  .pt .rrow .b {grid-column: 3;}
  .pt .rrow .d {grid-column: 4;}
}
</style>
  <nav class="toc" aria-label="Sections">
    <a href="#pt-timeline">Timeline</a><a href="#pt-prefs">Preferences</a><a href="#pt-favs">Favorites</a><a href="#pt-longest">Longest held</a><a href="#pt-ended">How each phone ended</a><a href="#pt-method">Method</a>
  </nav>
  <section id="pt-timeline">
    <h2>Timeline</h2>
    <div class="panel">
      <div class="legend" id="pt-legend"></div>
      <div class="scroll-x" id="pt-scroll"><svg id="pt-chart" role="img" aria-label="Timeline of every phone from 2008 to 2026 in Personal and Work lanes, with employers underneath and short stints as pins on a Tried row"></svg></div>
    </div>
  </section>
  <section id="pt-prefs">
    <h2>Preferences</h2>
    <div class="panel" id="pt-prefs-body"></div>
  </section>
  <section id="pt-favs">
    <h2>Favorites</h2>
    <div class="panel"><div class="favs" id="pt-favs-body"></div></div>
  </section>
  <section id="pt-longest">
    <h2>Longest held</h2>
    <div class="panel">
      <p class="note">Phones used 30 days or more</p>
      <div class="rank" id="pt-rank"></div>
      <h3>Short stints</h3>
      <div class="rank" id="pt-tried"></div>
    </div>
  </section>
  <section id="pt-ended">
    <h2>How each phone ended</h2>
    <div class="panel">
      <div class="ends" id="pt-ends"></div>
    </div>
  </section>
  <section id="pt-method" class="method-notes">
    <h2>Method</h2>
    <ul>
      <li>Preferences count days in each lane: Personal is the share of days each phone was the personal phone, Work the share of days it was the work phone. A phone covering both counts once, in the lane it was bought for. Phones under 30 days only count on personal days no other phone covered.</li>
      <li>Favorites are the phones rated 3 out of 3.</li>
      <li>Photos are official renders in the owned color, from Apple, Samsung, and GSMArena.</li>
    </ul>
  </section>
<div id="pt-tip" role="tooltip"></div>
<script src="/js/phone-timeline-data.js"></script>
<script src="/js/phone-timeline.js"></script>
</div>
{% endraw %}

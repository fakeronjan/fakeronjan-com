---
layout: base.njk
---
<article class="post">
  <p class="post-meta">
    {{ date | mdy }}
    {%- if original_source %} &middot; originally published on {{ original_source }}{% endif %}
  </p>
  {{ content | safe }}
</article>

{% set adjacent = collections.blog | adjacentPosts(page.url) %}
{% if adjacent.previous or adjacent.next %}
<nav class="post-adjacent" aria-label="Post navigation">
  {% if adjacent.previous %}
  <a class="post-adjacent-link post-adjacent-previous" href="{{ adjacent.previous.url }}">
    <span class="post-adjacent-label">&larr; Previous</span>
    <span class="post-adjacent-title">{{ adjacent.previous.data.title }}</span>
    <span class="post-adjacent-date">{{ adjacent.previous.data.date | mdy }}</span>
  </a>
  {% else %}<span></span>{% endif %}
  {% if adjacent.next %}
  <a class="post-adjacent-link post-adjacent-next" href="{{ adjacent.next.url }}">
    <span class="post-adjacent-label">Next &rarr;</span>
    <span class="post-adjacent-title">{{ adjacent.next.data.title }}</span>
    <span class="post-adjacent-date">{{ adjacent.next.data.date | mdy }}</span>
  </a>
  {% endif %}
</nav>
{% endif %}

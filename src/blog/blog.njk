---
layout: base.njk
title: Blog | FAKE RONJAN!!
permalink: /blog/
---

<h1>Blog</h1>

{%- set tagsShown = 4 %}
<div class="tag-filters collapsed" id="tagFilters">
  <button class="tag-filter active" data-filter="all">All ({{ collections.blog | countTag('all') }})</button>
  {%- for tag in tagList %}
  <button class="tag-filter{% if loop.index0 >= tagsShown %} tag-extra{% endif %}" data-filter="{{ tag.slug }}">{{ tag.label }} ({{ collections.blog | countTag(tag.slug) }})</button>
  {%- endfor %}
  <button class="tag-filter tag-more" type="button" aria-expanded="false">More tags</button>
</div>

<div class="post-grid" id="postGrid">
{%- for post in collections.blog %}
  <a class="post-tile" href="{{ post.url }}" data-tags="{{ (post.data.tags or []) | join(',') }}">
    <span class="post-tile-title">{{ post.data.title }}</span>
    {%- if post.data.tags and post.data.tags.length %}
    <span class="post-tile-tags">
      {%- for t in post.data.tags %}<span class="tag-pill">{{ t | tagLabel }}</span>{% endfor %}
    </span>
    {%- endif %}
    <span class="post-tile-meta">
      <span class="post-tile-date">{{ post.date | mdy }}</span>
      {%- if post.data.original_source %}
      <span class="post-source">{{ post.data.source_short or post.data.original_source }}</span>
      {%- endif %}
    </span>
  </a>
{%- endfor %}
</div>

<script>
function balanceTagFilters() {
  const container = document.getElementById("tagFilters");
  container.querySelectorAll(".row-break").forEach((el) => el.remove());
  const buttons = Array.from(container.querySelectorAll(".tag-filter")).filter((b) => b.offsetParent !== null);
  const n = buttons.length;
  if (n < 2) return;

  const containerWidth = container.clientWidth;
  const gap = parseFloat(getComputedStyle(container).gap) || 0;
  const widths = buttons.map((b) => b.getBoundingClientRect().width);
  // The More/Fewer toggle travels with the tag before it, so it never sits alone on a row
  const glued = (i) => buttons[i].classList.contains("tag-more") && i > 0;

  // Greedy packing at a given max row width -> indexes where new rows start
  const pack = (maxW) => {
    const starts = [0];
    let used = 0;
    widths.forEach((w, i) => {
      const next = used + (used > 0 ? gap : 0) + w;
      if (next > maxW && used > 0) {
        if (glued(i) && starts[starts.length - 1] < i - 1) {
          starts.push(i - 1); used = widths[i - 1] + gap + w;  // carry the previous tag down with it
        } else { starts.push(i); used = w; }
      } else { used = next; }
    });
    return starts;
  };
  const rows = pack(containerWidth).length;
  if (rows < 2) return;
  // Shrink the target width as far as possible without adding a row, so the
  // rows come out evenly filled and nothing is stranded on a row by itself.
  let lo = Math.max(...widths), hi = containerWidth;
  while (hi - lo > 1) {
    const mid = (lo + hi) / 2;
    if (pack(mid).length > rows) lo = mid; else hi = mid;
  }
  pack(hi).slice(1).forEach((idx) => {
    const brk = document.createElement("span");
    brk.className = "row-break";
    brk.style.flexBasis = "100%";
    brk.style.width = "0";
    brk.style.height = "0";
    buttons[idx].parentNode.insertBefore(brk, buttons[idx]);
  });
}
window.addEventListener("load", balanceTagFilters);
window.addEventListener("resize", balanceTagFilters);

document.getElementById("tagFilters").addEventListener("click", (e) => {
  const btn = e.target.closest(".tag-filter");
  if (!btn) return;
  const container = document.getElementById("tagFilters");
  if (btn.classList.contains("tag-more")) {
    // Collapsing keeps the selected tag visible (CSS: .tag-extra.active stays shown)
    const collapsed = container.classList.toggle("collapsed");
    btn.textContent = collapsed ? "More tags" : "Fewer tags";
    btn.setAttribute("aria-expanded", String(!collapsed));
    balanceTagFilters();
    return;
  }
  document.querySelectorAll(".tag-filter:not(.tag-more)").forEach((b) => b.classList.toggle("active", b === btn));
  const filter = btn.dataset.filter;
  document.querySelectorAll(".post-tile").forEach((tile) => {
    const tags = (tile.dataset.tags || "").split(",");
    tile.style.display = filter === "all" || tags.includes(filter) ? "" : "none";
  });
});
</script>

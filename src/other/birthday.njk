---
layout: base.njk
title: Birthday Stats | FAKE RONJAN!!
permalink: /birthday/
---

<style>
.bd h2 { margin: 2rem 0 0.6rem; font-size: 1.2rem; text-wrap: balance; }
.bd-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; margin: 0.5rem 0 0.5rem; }
.bd-controls label { font-weight: 600; }
.bd-controls input {
  font: inherit; font-size: 1rem; padding: 0.4rem 0.6rem; color: var(--fg); background: var(--bg);
  border: 1px solid var(--muted); border-radius: 6px;
}
.bd-controls input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
.bd-note { color: var(--muted); font-size: 0.88rem; margin: 0 0 0.5rem; }
.bd-note[hidden] { display: none; }

.bd-list { list-style: none; padding: 0; margin: 0; }
.bd-list li {
  display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) auto; gap: 0.2rem 1rem; align-items: baseline;
  padding: 0.5rem 0; border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
}
.bd-list .bd-who { min-width: 0; }
.bd-list .bd-who a { font-weight: 600; }
.bd-desc { display: block; color: var(--muted); font-size: 0.88rem; text-wrap: pretty; }
.bd-year, .bd-gap, .bd-edate { font-variant-numeric: tabular-nums; color: var(--muted); font-size: 0.9rem; }
.bd-gap.same { color: var(--accent-2); font-weight: 700; }
.bd-born { color: var(--muted); font-size: 0.85rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
.bd-tag { white-space: nowrap; }
.bd-tag::before { content: "\00b7\00a0"; }
.bd-none { display: block !important; color: var(--muted); border-bottom: 0 !important; }
.bd-same-list li { grid-template-columns: 7.5rem minmax(0, 1fr); }
.bd-events li { grid-template-columns: 10.5rem minmax(0, 1fr); }
.bd-edate { white-space: nowrap; }
.bd-same-list li { grid-template-columns: 3.5rem minmax(0, 1fr); }
.bd-twins { background: color-mix(in srgb, var(--accent-2) 8%, transparent); border-radius: 8px; padding: 0.6rem 0.8rem; margin: 0 0 0.8rem; }
.bd-more { margin-top: 0.7rem; cursor: pointer; }
.bd-more[hidden] { display: none; }

.bd-groups { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 0.8rem; }
.bd .pill { cursor: pointer; }
.bd .pill:disabled { opacity: 0.45; cursor: default; }
.bd-count { opacity: 0.75; font-variant-numeric: tabular-nums; margin-left: 0.15rem; }

.bd-kicker { margin: 0; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
.bd-headline { margin: 0.2rem 0 0.9rem; font-family: "Space Grotesk", sans-serif; font-size: 1.6rem; font-weight: 700; line-height: 1.2; text-wrap: balance; }
.bd-headline a { color: var(--fg); text-decoration: none; }
.bd-headline a:hover { color: var(--accent); }
.bd-hdate { display: block; font-family: inherit; font-size: 1rem; font-weight: 500; color: var(--muted); margin-top: 0.2rem; }
.bd-half p { text-wrap: pretty; }

/* Photos: Wikipedia lead images (Wikimedia Commons). No photo: a circle with initials */
.bd-face { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; display: block; flex: none; background: color-mix(in srgb, var(--fg) 6%, transparent); }
.bd-face.ini { display: grid; place-items: center; color: var(--muted); font-size: 0.95rem; font-weight: 700; }
.bd-list li.with-face { grid-template-columns: 7.5rem 56px minmax(0, 1fr) auto; align-items: center; }
.bd-same-list li.with-face { grid-template-columns: 3.5rem 56px minmax(0, 1fr); }
.bd-sec[hidden] { display: none; }
.bd .sport-tabs { margin-top: 1rem; }

/* Same birthday: a tear-off calendar page and the day's five most famous faces */
.bd-cal-row { display: flex; flex-wrap: wrap; gap: 1rem 1.4rem; align-items: center; margin: 0.4rem 0 1.2rem; }
.bd-cal { width: 112px; flex: none; text-align: center; border-radius: 10px; overflow: hidden; background: var(--bg);
  border: 1px solid color-mix(in srgb, var(--fg) 14%, transparent); box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08); }
.bd-cal-mon { background: var(--accent-2); color: #fff; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.25rem 0; }
.bd-cal-day { font-family: "Space Grotesk", sans-serif; font-size: 3.4rem; font-weight: 700; line-height: 1.15; padding: 0.2rem 0 0.35rem; }
.bd-five { display: flex; flex-wrap: wrap; gap: 0.8rem; min-width: 0; }
.bd-five a { width: 118px; text-align: center; text-decoration: none; color: var(--fg); font-size: 0.78rem; font-weight: 600; line-height: 1.25; }
.bd-five .bd-face { width: 104px; height: 104px; margin: 0 auto 0.35rem; font-size: 1.3rem; }
.bd-five span { display: block; color: var(--muted); font-weight: 400; }

/* Timelines (Closest in age, Halfway back): SVG drawn at the box's own width */
.bd-tl { margin: 0.4rem 0 1.2rem; }
.bd-tl svg { display: block; width: 100%; height: auto; overflow: visible; }
.bd-tl .axis { stroke: var(--fg); stroke-width: 2; }
.bd-tl .stem { stroke: color-mix(in srgb, var(--fg) 22%, transparent); stroke-width: 1.5; }
.bd-tl .ring { fill: none; stroke: var(--bg); stroke-width: 2.5; }
.bd-tl .ini-c { fill: color-mix(in srgb, var(--fg) 10%, var(--bg)); }
.bd-tl .ini-t { fill: var(--muted); font-size: 12px; font-weight: 700; text-anchor: middle; dominant-baseline: central; }
.bd-tl .you { stroke: var(--accent-2); stroke-width: 2.5; stroke-dasharray: 4 4; }
.bd-tl .you-l { fill: var(--accent-2); font-size: 13px; font-weight: 700; text-anchor: middle; }
.bd-tl .end { fill: var(--muted); font-size: 12px; }
.bd-tl .zone { fill: color-mix(in srgb, var(--accent) 16%, transparent); }
.bd-tl .zone-l { fill: var(--accent); font-size: 13px; font-weight: 700; text-anchor: middle; }
.bd-tl .ev { fill: var(--accent); opacity: 0.7; }
.bd-tl .ev.top { opacity: 1; stroke: var(--bg); stroke-width: 1.5; }
.bd-tl .lead { stroke: var(--accent); stroke-width: 1.2; }
.bd-tl .num-c { fill: var(--accent); stroke: var(--bg); stroke-width: 2; }
.bd-tl .num-t { fill: var(--bg); font-size: 11px; font-weight: 700; text-anchor: middle; dominant-baseline: central; }
/* Key under the halfway timeline: the numbered events in three groups */
.bd-key { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 0.4rem 1.6rem; margin-top: 0.8rem; }
.bd-key h3 { margin: 0 0 0.3rem; font-size: 0.78rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
.bd-key ol { margin: 0; padding-left: 1.6rem; }
.bd-key li { margin: 0.2rem 0; font-size: 0.92rem; line-height: 1.35; }
.bd-key li::marker { color: var(--accent); font-weight: 700; }
.bd-key li span { display: block; color: var(--muted); font-size: 0.8rem; }
.bd-tl .ev-l { fill: var(--fg); font-size: 12.5px; font-weight: 600; }
.bd-tl .ev-y { fill: var(--muted); font-weight: 400; }
.bd-tl .mk { stroke: var(--muted); stroke-width: 2.5; }
.bd-tl .mk.born { stroke: var(--accent-2); } .bd-tl .mk.half { stroke: var(--fg); }
.bd-tl .mk-l { fill: var(--fg); font-size: 12.5px; font-weight: 700; } .bd-tl .mk-l.born { fill: var(--accent-2); }
.bd-tl .mk-d { fill: var(--muted); font-size: 11.5px; }
.bd-tl a:focus-visible circle.ring { stroke: var(--accent); }

@media (max-width: 560px) {
  .bd-list li, .bd-events li { grid-template-columns: 1fr; gap: 0.1rem; }
  .bd-list li.with-face { grid-template-columns: 52px minmax(0, 1fr); column-gap: 0.7rem; }
  .bd-list .bd-face { width: 52px; height: 52px; }
  .bd-list li.with-face > .bd-gap, .bd-list li.with-face > .bd-year { grid-column: 1 / -1; }
  .bd-list li.with-face > .bd-born { grid-column: 2; }
  .bd-five { gap: 0.6rem; } .bd-five a { width: calc((100% - 1.2rem) / 3); max-width: 96px; } .bd-five .bd-face { width: 84px; height: 84px; }
  .bd-same-list li { grid-template-columns: 3rem minmax(0, 1fr); }
  .bd-born { white-space: normal; }
  .bd-headline { font-size: 1.35rem; }
}
</style>

<div class="bd">
  <h1>Birthday Stats</h1>

  <div class="bd-controls">
    <label for="bd-date">Your birthday</label>
    <input id="bd-date" type="date" min="1900-01-01">
  </div>
  <p class="bd-note" id="bd-example" hidden>Showing an example birthday until you enter yours. It stays in your browser.</p>

  <nav class="sport-tabs" id="bd-tabs" aria-label="Section">
    <button class="sport-tab active" data-tab="same" type="button">Same birthday</button>
    <button class="sport-tab" data-tab="age" type="button">Closest in age</button>
    <button class="sport-tab" data-tab="half" type="button">Halfway back</button>
  </nav>

  <section class="bd-sec" id="bd-sec-same">
    <h2 id="bd-same-title">Same birthday</h2>
    <div class="bd-cal-row" id="bd-cal"></div>
    <div id="bd-twins"></div>
    <ul class="bd-list bd-same-list" id="bd-same"></ul>
    <button class="pill bd-more" id="bd-same-more" type="button" hidden></button>
  </section>

  <section class="bd-sec" id="bd-sec-age" hidden>
    <h2>Closest in age</h2>
    <div class="bd-groups" id="bd-groups"></div>
    <div class="bd-tl" id="bd-age-tl"></div>
    <ul class="bd-list" id="bd-age"></ul>
    <button class="pill bd-more" id="bd-age-more" type="button" hidden></button>
  </section>

  <section class="bd-sec" id="bd-sec-half" hidden>
    <h2>Halfway back</h2>
    <div class="bd-tl" id="bd-half-tl"></div>
    <div class="bd-half" id="bd-half-head"></div>
    <ul class="bd-list bd-events" id="bd-events"></ul>
    <button class="pill bd-more" id="bd-events-more" type="button" hidden></button>
  </section>
</div>

<script type="module" src="/js/birthday-page.js"></script>

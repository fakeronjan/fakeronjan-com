.sun-field { position: relative; flex: 1 1 240px; min-width: 0; max-width: 460px; display: flex; }
.sun-field input {
  flex: 1; min-width: 0; font: inherit; font-size: 0.85rem; padding: 0.35rem 0.55rem;
  color: var(--fg); background: var(--bg); border: 1px solid var(--muted); border-radius: 6px;
}
.sun-field input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
.sun-results {
  position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 10; margin: 0; padding: 0.25rem 0;
  list-style: none; background: var(--bg); border: 1px solid var(--muted); border-radius: 6px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
}

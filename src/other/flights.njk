      <ul class="fl-list" id="fl-from-list" hidden></ul>
    </div>
    <button class="fl-swap" id="fl-swap" type="button" aria-label="Swap airports">&#8644;</button>
    <div class="fl-field">
      <label for="fl-to">To</label>
      <input id="fl-to" type="text" autocomplete="off" placeholder="Airport code or city">
      <ul class="fl-list" id="fl-to-list" hidden></ul>
    </div>
  </div>
  <div class="fl-controls" id="fl-pick-airport" hidden>
    <div class="fl-field">
      <label for="fl-ap">Airport</label>
      <input id="fl-ap" type="text" autocomplete="off" placeholder="Airport code or city">

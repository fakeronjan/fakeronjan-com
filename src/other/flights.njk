<div class="fl">
  <h1>Flight Stats</h1>

  <div class="fl-nav">
    <div class="fl-seg fl-tabs" id="fl-tabs" role="group" aria-label="Section"><button class="active" data-tab="routes" type="button">Routes</button><button data-tab="airports" type="button">Airports</button><button data-tab="airlines" type="button">Airlines</button></div>
    <div class="fl-seg" id="fl-mode" role="group" aria-label="View"><button class="active" data-mode="lookup" type="button">Look up</button><button data-mode="rank" type="button">Rankings</button></div>
  </div>


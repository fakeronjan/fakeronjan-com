.fl-title a { color: inherit; text-decoration: none; border-bottom: 2px solid color-mix(in srgb, var(--accent) 40%, transparent); }
.fl-title a:hover { color: var(--accent); }
.fl-title-logo { display: flex; align-items: center; gap: 0.7rem; }
.fl-title-logo .fl-logo img { height: 30px; max-width: 170px; }
.fl-sub { color: var(--muted); margin: 0; text-wrap: pretty; }

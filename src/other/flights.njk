.fl-rk-ap { flex: 0 1 220px; }
.fl-rk-table td.rk { color: var(--muted); width: 3.5rem; text-align: left; padding-left: 0; }
.fl-rk-table td.nm, .fl-rk-table th.nm { text-align: left; }
.fl-rk-table td.nm small { display: inline; margin-left: 0.4rem; }
.fl-rk-table td.nm a, .fl-rk-table td.val { white-space: nowrap; }
@media (max-width: 560px) { .fl-rk-table td.nm small { display: block; margin-left: 0; } }
.fl-rk-table td.nm a { font-weight: 600; }
.fl-rk-table tr.hl td { background: color-mix(in srgb, var(--accent) 12%, transparent); }
.fl-rk-table tr.gap td { text-align: center; color: var(--muted); border-bottom: 0; }
.fl-more { margin-top: 0.7rem; }

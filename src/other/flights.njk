<style>
/* Status colors for the on-time split; bars and logos follow the site's tokens */
.fl { --ok: #15803d; --late: #d97706; --cancel: #b91c1c; --divert: #7c7f86; --bar: var(--accent); --panel: color-mix(in srgb, var(--fg) 5%, transparent); --line: color-mix(in srgb, var(--fg) 12%, transparent); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .fl { --ok: #34d399; --late: #fbbf24; --cancel: #f87171; --divert: #9ca3af; } }
:root[data-theme="dark"] .fl { --ok: #34d399; --late: #fbbf24; --cancel: #f87171; --divert: #9ca3af; }

.fl h2 { margin: 2rem 0 0.6rem; font-size: 1.2rem; text-wrap: balance; }
.fl h3 { margin: 1rem 0 0.4rem; font-size: 0.95rem; }
.fl-controls { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: flex-end; margin: 0.5rem 0 0.6rem; }
.fl-field { position: relative; flex: 1 1 200px; max-width: 300px; }
.fl-field label, .fl-period label { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.15rem; }
.fl-field input, .fl select {
  width: 100%; box-sizing: border-box; font: inherit; font-size: 0.95rem; padding: 0.45rem 0.6rem; color: var(--fg); background: var(--bg);
  border: 1px solid var(--muted); border-radius: 6px;
}
.fl select { width: auto; }
.fl-field input:focus, .fl select:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
.fl-list { position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 10; margin: 0; padding: 0.25rem 0; list-style: none; background: var(--bg); border: 1px solid var(--muted); border-radius: 6px; box-shadow: 0 6px 20px rgba(0,0,0,0.15); }
.fl-list[hidden] { display: none; }
.fl-list button { display: block; width: 100%; text-align: left; font: inherit; font-size: 0.9rem; padding: 0.4rem 0.7rem; color: var(--fg); background: none; border: 0; cursor: pointer; }
.fl-list button:hover, .fl-list button:focus { background: color-mix(in srgb, var(--accent) 12%, transparent); }
.fl-none { padding: 0.4rem 0.7rem; color: var(--muted); font-size: 0.9rem; }
.fl-swap { width: 2.3rem; height: 2.3rem; border-radius: 50%; border: 1px solid var(--muted); background: none; color: var(--accent); font-size: 1.15rem; cursor: pointer; flex: none; }
.fl-swap:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
.fl-row2 { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; }
.fl-seg { display: inline-flex; border: 1px solid var(--accent); border-radius: 999px; padding: 3px; }
.fl-seg button { font: inherit; font-size: 0.8rem; font-weight: 600; color: var(--accent); background: none; border: 0; border-radius: 999px; padding: 0.3rem 0.8rem; cursor: pointer; white-space: nowrap; }
.fl-seg button.active { background: var(--accent); color: var(--bg); }
.fl-period { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
.fl-period label { margin: 0; }
.fl-period [hidden] { display: none; }

.fl-route { font-family: "Space Grotesk", sans-serif; font-size: 1.7rem; font-weight: 700; margin: 1.4rem 0 0; }
.fl-route-sub { color: var(--muted); margin: 0; text-wrap: pretty; }
.fl-period-line { margin: 0.1rem 0; font-weight: 700; color: var(--accent); }
.fl .fl-showing { font-size: 0.85rem; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--fg); }
.fl-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0 1.4rem; margin: 0.7rem 0 0; }
.fl-facts div { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.4rem 0; border-bottom: 1px solid var(--line); }
.fl-facts dt { color: var(--muted); } .fl-facts dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }

.fl-stack { display: flex; gap: 2px; height: 28px; border-radius: 6px; overflow: hidden; }
.fl-stack span { min-width: 2px; }
.s-ok { --c: var(--ok); } .s-late { --c: var(--late); } .s-cancel { --c: var(--cancel); } .s-divert { --c: var(--divert); }
.fl-stack span { background: var(--c); }
.fl-legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin: 0.5rem 0 0; font-size: 0.88rem; }
.fl-legend span::before { content: ""; display: inline-block; width: 0.65rem; height: 0.65rem; border-radius: 2px; margin-right: 0.4rem; background: var(--c); vertical-align: -0.05rem; }
.fl-legend b { font-variant-numeric: tabular-nums; }
.fl-rank { margin: 0.8rem 0 0; padding-left: 1.2rem; } .fl-rank li { margin: 0.2rem 0; }
.fl-note { color: var(--muted); font-size: 0.85rem; margin: 0.3rem 0 0; text-wrap: pretty; }

.fl table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
.fl th, .fl td { text-align: right; padding: 0.45rem 0.5rem; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; vertical-align: middle; }
.fl th:first-child, .fl td:first-child { text-align: left; padding-left: 0; }
.fl thead th { color: var(--muted); font-size: 0.8rem; font-weight: 700; }
.fl td small { display: block; color: var(--muted); font-size: 0.78rem; }
.fl-logo { display: inline-flex; align-items: center; background: #fff; border-radius: 4px; padding: 2px 5px; }
.fl-logo img { height: 20px; width: auto; max-width: 110px; object-fit: contain; display: block; }
.fl-logo.sm img { height: 14px; max-width: 70px; }
.fl-brand { font-weight: 600; }
@media (max-width: 560px) { .hide-sm { display: none; } .fl-logo img { height: 16px; max-width: 86px; } }
.fl-scroll { overflow-x: auto; }

.fl-charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.6rem 1.6rem; }
.fl-bars { display: flex; align-items: flex-end; gap: 2px; height: 120px; border-bottom: 1px solid var(--muted); }
.fl-bars div { flex: 1; background: var(--bar); border-radius: 3px 3px 0 0; opacity: 0.85; }
.fl-bars div:hover { opacity: 1; outline: 2px solid var(--fg); }
.fl-bars div.best { background: var(--ok); } .fl-bars div.worst { background: var(--cancel); }
.fl-bars div.empty { background: none; }
.fl-bars div.out { opacity: 0.28; }
.fl-ticks { display: flex; gap: 2px; font-size: 0.7rem; color: var(--muted); }
.fl-ticks span { flex: 1; text-align: center; white-space: nowrap; min-width: 0; }

.fl-causes div { display: grid; grid-template-columns: 11.5rem 1fr 3rem; gap: 0.6rem; align-items: center; margin: 0.35rem 0; font-size: 0.9rem; }
.fl-causes .track { height: 12px; background: var(--panel); border-radius: 4px; overflow: hidden; }
.fl-causes .fill { display: block; height: 100%; background: var(--late); border-radius: 4px; }
.fl-causes b { text-align: right; font-variant-numeric: tabular-nums; }
@media (max-width: 520px) { .fl-causes div { grid-template-columns: 8.5rem 1fr 2.6rem; font-size: 0.85rem; } }

.fl-fun { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.6rem; }
.fl-fun div { background: var(--panel); border-radius: 8px; padding: 0.6rem 0.8rem; }
.fl-fun small { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
.fl-fun b { display: block; font-family: "Space Grotesk", sans-serif; font-size: 1.15rem; margin: 0.1rem 0; }
.fl-fun span { color: var(--muted); font-size: 0.85rem; }
.fl-tip { position: fixed; pointer-events: none; z-index: 20; background: var(--fg); color: var(--bg); font-size: 0.8rem; padding: 0.3rem 0.5rem; border-radius: 6px; white-space: nowrap; }
.fl-tip[hidden], #fl-body[hidden] { display: none; }

.fl-tabs { margin: 0.2rem 0 1rem; }
.fl-badge {
  display: inline-block; font-size: 0.72rem; font-weight: 700; line-height: 1.2; padding: 0.15rem 0.5rem; border-radius: 999px;
  color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); text-decoration: none; white-space: nowrap; vertical-align: 0.1rem;
}
.fl-badge.b-top { color: var(--bg); background: var(--accent); }
.fl-badge:hover { outline: 1px solid var(--accent); }
.fl-facts div { flex-wrap: wrap; }
.fl-bw { flex-basis: 100%; text-align: right; margin-top: -0.1rem; }
.fl-badges { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.6rem 0 0; }
.fl-badges:empty { display: none; }
#fl-rankings[hidden], #fl-route-view[hidden], #fl-route-controls[hidden] { display: none; }
.fl-rk-row { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin: 0.6rem 0; }
.fl-rk-row .fl-seg:empty { display: none; }
.fl-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.6rem 0; }
.fl .pill { cursor: pointer; }
.fl-rk-ap { flex: 0 1 220px; }
.fl-rk-table td.rk { color: var(--muted); width: 3.5rem; text-align: left; padding-left: 0; }
.fl-rk-table td.nm, .fl-rk-table th.nm { text-align: left; }
.fl-rk-table td.nm small { display: inline; margin-left: 0.4rem; }
.fl-rk-table td.nm a, .fl-rk-table td.val { white-space: nowrap; }
@media (max-width: 560px) { .fl-rk-table td.nm small { display: block; margin-left: 0; } }
.fl-rk-table td.nm a { font-weight: 600; }
.fl-rk-table tr.hl td { background: color-mix(in srgb, var(--accent) 12%, transparent); }
.fl-rk-table tr.gap td { text-align: center; color: var(--muted); border-bottom: 0; }
.fl-more { margin-top: 0.7rem; }
.fl-more[hidden] { display: none; }
.fl-how { margin-top: 2.5rem; padding-top: 0.5rem; border-top: 1px solid var(--line); }
.fl-how li { margin: 0.4rem 0; text-wrap: pretty; }
.fl-how a { color: var(--accent); }
</style>

<div class="fl">

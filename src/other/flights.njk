.fl td small { display: block; color: var(--muted); font-size: 0.78rem; }
.fl-compare th button.fl-sort { font: inherit; font-weight: 700; color: var(--muted); background: none; border: 0; cursor: pointer; padding: 0; text-align: inherit; }

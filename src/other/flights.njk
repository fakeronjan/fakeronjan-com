    <div class="fl-rk-row">
      <div class="fl-seg" id="fl-rk-order" role="group" aria-label="Order"></div>
      <div class="fl-field fl-rk-ap" id="fl-rk-ap-wrap">
        <input id="fl-rk-ap" type="text" autocomplete="off" placeholder="Any airport" aria-label="Only routes touching this airport">

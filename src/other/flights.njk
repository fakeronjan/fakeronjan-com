  </div>
  <div class="fl-row2">
    <div class="fl-seg" id="fl-dir" role="group" aria-label="Direction"><button class="active" data-d="one" type="button">One way</button><button data-d="both" type="button">Both directions</button></div>
    <div class="fl-period">
      <label for="fl-y0" class="fl-showing">Showing</label>
      <select id="fl-y0"></select>
      <label id="fl-y1-label" for="fl-y1" class="fl-showing" hidden>to</label>
      <select id="fl-y1" aria-label="Period end" hidden></select>
    </div>
  </div>

  <section id="fl-rankings" hidden>
    <div class="fl-rk-row">
      <div class="fl-seg" id="fl-rk-kind" role="group" aria-label="Rank"><button class="active" data-k="routes" type="button">Routes</button><button data-k="airports" type="button">Airports</button></div>
    </div>

.fl-nav { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; margin: 0.2rem 0 1rem; }
.fl-tabs button { font-size: 0.9rem; padding: 0.35rem 1rem; }
.fl-controls[hidden], .fl-al-picks[hidden], .fl-seg[hidden] { display: none; }

.fl-al-pick { border: 1px solid var(--line); border-radius: 8px; background: none; padding: 0.35rem; cursor: pointer; }
.fl-al-pick.active { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
.fl-al-pick .fl-logo img { height: 22px; max-width: 120px; }

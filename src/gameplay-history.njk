{% include "video-games-nav.njk" %}

<div class="sport-page gh-page" id="ghPage" data-source="https://fakeronjan.github.io/gameplay-tracking" data-shots="https://fakeronjan.github.io/gameplay-screenshots">
  <h1>Gameplay History</h1>
  <nav class="sport-tabs" id="ghTabs">
    <button class="sport-tab active" data-tab="data-summary" type="button">Data Summary</button>
    <button class="sport-tab" data-tab="timeline" type="button">Timeline</button>
    <button class="sport-tab" data-tab="games" type="button">Games</button>
    <button class="sport-tab" data-tab="trophy-room" type="button">Trophy Room</button>
  </nav>
  <div class="sport-controls" id="ghMinBar" hidden>
    <label class="gh-min-label" for="ghMin">Show games played at least</label>
    <select id="ghMin" class="sport-select">
      <option value="1">1 day or 1 hour</option>
      <option value="2" selected>2 days or 2 hours</option>
      <option value="3">3 days or 3 hours</option>
      <option value="5">5 days or 5 hours</option>
      <option value="10">10 days or 10 hours</option>
    </select>
    <span class="sport-count" id="ghMinCount"></span>
  </div>
  <p id="ghError" class="sport-note sport-note-warn" hidden>Couldn't load gameplay data. Try refreshing the page.</p>

  <section class="sport-view active" data-view="data-summary" id="data-summary">
    <div class="sport-table-wrap gh-accounts">
      <table class="sport-table gh-table">
        <thead><tr><th>Platform</th><th class="gh-hide-m">Account</th><th class="gh-hide-m">Data Tracked</th><th>Dates Covered</th><th>Updates</th></tr></thead>
        <tbody>
        <tr>
          <td><i class="gh-dot gh-nintendo"></i>Nintendo</td>
          <td class="gh-wrap gh-hide-m"><div class="gh-account"><span class="gh-account-imgs"><img src="https://fakeronjan.github.io/gameplay-tracking/avatars/nintendo.png" alt=""></span><span class="gh-lineage"><span class="gh-nowrap">ronjan</span></span></div></td>
          <td class="gh-wrap gh-hide-m gh-tracked"><span>Miiverse posts <span class="gh-nowrap">(3DS, Wii U)</span></span><span>Screenshots <span class="gh-nowrap">(Switch, Switch 2)</span></span></td>
          <td class="gh-dates" data-range="Nintendo">Loading...</td>
          <td>Manually</td>
        </tr>
        <tr>
          <td><i class="gh-dot gh-playstation"></i>PlayStation</td>
          <td class="gh-wrap gh-hide-m"><div class="gh-account"><span class="gh-account-imgs"><img src="https://fakeronjan.github.io/gameplay-tracking/avatars/psn.png" alt=""></span><span class="gh-lineage"><span class="gh-nowrap">thesurfshop19 &#8594;</span> <span class="gh-nowrap">fakeronjan &#8594;</span> <span class="gh-nowrap">octopersona</span></span></div></td>
          <td class="gh-wrap gh-hide-m gh-tracked"><span>Trophies <span class="gh-nowrap">(PS3, PS4, PS5, Vita)</span></span><span>Play time and sessions <span class="gh-nowrap">(PS4, PS5)</span></span><span>Screenshots <span class="gh-nowrap">(PS5)</span></span></td>
          <td class="gh-dates" data-range="PlayStation" data-updated="psn_ok">Loading...</td>
          <td>Daily</td>
        </tr>
        <tr>
          <td><i class="gh-dot gh-steam"></i>Steam</td>
          <td class="gh-wrap gh-hide-m"><div class="gh-account"><span class="gh-account-imgs"><img src="https://fakeronjan.github.io/gameplay-tracking/avatars/steam.jpg" alt=""></span><span class="gh-lineage"><span class="gh-nowrap">thesurfshop19 &#8594;</span> <span class="gh-nowrap">octopersona</span></span></div></td>
          <td class="gh-wrap gh-hide-m gh-tracked"><span>Achievements</span><span>Play time</span></td>
          <td class="gh-dates" data-range="Steam" data-updated="steam_ok">Loading...</td>
          <td>Daily</td>
        </tr>
        <tr>
          <td><i class="gh-dot gh-xbox"></i>Xbox</td>
          <td class="gh-wrap gh-hide-m"><div class="gh-account"><span class="gh-account-imgs"><img class="gh-pixel" src="https://fakeronjan.github.io/gameplay-tracking/avatars/xbox_thesurfshop19.png" alt=""><img class="gh-pixel" src="https://fakeronjan.github.io/gameplay-tracking/avatars/xbox_rogerage.png" alt=""><img src="https://fakeronjan.github.io/gameplay-tracking/avatars/xbox_fakeronjan.png" alt=""></span><span class="gh-lineage"><span class="gh-nowrap">thesurfshop19 &#8594;</span> <span class="gh-nowrap">rogerage &#8594;</span> <span class="gh-nowrap">fakeronjan</span></span></div></td>
          <td class="gh-wrap gh-hide-m gh-tracked"><span>Achievements <span class="gh-nowrap">(360 and later)</span></span><span>Play time <span class="gh-nowrap">(Xbox One and later)</span></span></td>
          <td class="gh-dates" data-range="Xbox">Loading...</td>
          <td>Manually</td>
        </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="sport-view" data-view="timeline" id="timeline" hidden>
    <div class="sport-controls">
      <select id="ghYear" class="sport-select" aria-label="Year"><option value="">All years</option></select>
      <span class="sport-count" id="ghYearCount"></span>
    </div>
    <div class="gh-legend" id="ghLegend"></div>
    <div id="ghTimeline"><p class="sport-loading">Loading...</p></div>
  </section>

  <section class="sport-view" data-view="games" id="games" hidden>
    <div class="sport-controls">
      <div class="pill-group" id="ghGamesPills"></div>
      <input id="ghGamesSearch" class="gh-search" type="search" placeholder="Search games" aria-label="Search games">
      <span class="sport-count" id="ghGamesCount"></span>
    </div>
    <div class="sport-table-wrap" id="ghGamesTable"></div>
    <p class="sport-note gh-after">Hours come from PlayStation (PS4 and PS5), Xbox One and later, and Steam. Sessions are PlayStation only. ~ marks hours from a collection, shared across its games by days played. Nintendo days only count days with a Switch screenshot or a Miiverse post.</p>
  </section>

  <section class="sport-view" data-view="trophy-room" id="trophy-room" hidden>
    <div class="sport-controls">
      <div class="pill-group" id="ghUnlockPills"></div>
      <input id="ghUnlockSearch" class="gh-search" type="search" placeholder="Search unlocks or games" aria-label="Search unlocks or games">
      <span class="sport-count" id="ghUnlockCount"></span>
    </div>
    <div class="sport-table-wrap" id="ghUnlockTable"><p class="sport-loading" id="ghUnlockLoading"></p></div>
    <p class="sport-note gh-after">Rarity is the share of everyone on that platform who has earned it.</p>
  </section>
</div>

<dialog class="gh-lightbox" id="ghLightbox" aria-label="Screenshot">
  <img id="ghLightboxImg" alt="">
  <div class="gh-lightbox-bar">
    <button type="button" id="ghLightboxPrev" aria-label="Previous screenshot">&#8592;</button>
    <span id="ghLightboxCap"></span>
    <button type="button" id="ghLightboxNext" aria-label="Next screenshot">&#8594;</button>
  </div>
</dialog>

<script src="/js/sports-url.js?v={{ buildTime }}"></script>
<script src="/js/gameplay-history.js?v={{ buildTime }}"></script>
